# TELNYX API Configuration
# Get your API key from: https://portal.telnyx.com/#/app/api-keys
TELNYX_API_KEY=KEY01234567890ABCDEFGHIJKLMNOPQRSTUVWXYZ

# TELNYX Public Key (for webhook signature verification)
# Found in: https://portal.telnyx.com/#/app/account/public-key
TELNYX_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nYourPublicKeyHere\n-----END PUBLIC KEY-----

# Messaging Profile ID
# Found in: https://portal.telnyx.com/#/app/messaging
TELNYX_PROFILE_ID=40000000-0000-0000-0000-000000000000

# Default phone number for outbound communications (E.164 format)
TELNYX_FROM_NUMBER=+15555551234

# Webhook Configuration
# Secret for webhook signature validation
WEBHOOK_SECRET=your_webhook_secret_here

# Public URL where TELNYX will send webhook events
# For local development, use ngrok: https://ngrok.com
# Example: https://abc123.ngrok.io/webhooks/telnyx
WEBHOOK_URL=https://your-domain.com/webhooks/telnyx

# Server Configuration
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Optional: Connection ID for voice calls
# Found in: https://portal.telnyx.com/#/app/connections
TELNYX_CONNECTION_ID=

# Optional: Rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
